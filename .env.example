# Terracierta by Onyx — variables de entorno
# SOLO NOMBRES: los valores van en .env.local (que NO se sube al repo) o en el panel de Vercel.
# Con `npm run dev:local` NO hace falta crear .env.local: las llaves locales salen de `supabase status`.

# Interruptor de adaptadores. true = pagos y login simulados (mocks).
# Cualquier otro valor, o ausente = módulos reales (src/payments y src/auth).
USE_MOCKS=true

# Supabase (proyecto en la nube: Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
# Llave PÚBLICA (anon / sb_publishable_...). Puede ir en el navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Llave PRIVADA (service_role / sb_secret_...). Solo servidor: NUNCA con prefijo NEXT_PUBLIC_, nunca en el repo.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional. En Vercel se toma solo de la URL del despliegue; en local por defecto es http://localhost:3000
# NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3100

# --- Open Payments oficial: solo servidor ---
PAYMENTS_RAIL=open-payments
# Wallet de cliente registrada con la llave pública correspondiente.
OPEN_PAYMENTS_CLIENT_WALLET=
# Wallet del comprador de demo; si falta, usa la wallet de cliente.
# Solo la demo autónoma usa este valor; checkout toma walletPagador del perfil validado.
OPEN_PAYMENTS_SENDER_WALLET=
OPEN_PAYMENTS_KEY_ID=
# Ruta local a private.key. No copies la llave al repositorio.
OPEN_PAYMENTS_PRIVATE_KEY_PATH=
# Alternativa para secret manager; nunca uses NEXT_PUBLIC_ para esta llave.
OPEN_PAYMENTS_PRIVATE_KEY=
OPEN_PAYMENTS_REDIRECT_ORIGIN=http://127.0.0.1:3100
# Importes en unidades mayores. El débito incluye cualquier tarifa del proveedor.
# Son topes de prueba, no el precio del café; no se amplían automáticamente.
OPEN_PAYMENTS_MAX_RECEIVE=0.05
OPEN_PAYMENTS_MAX_DEBIT=0.05
# false permite consultar la cotización, pero bloquea autorización y ejecución.
PAYMENTS_EXECUTION_ENABLED=true
# La página pública de demo está deshabilitada en producción por defecto.
PASARELA_DEMO_ENABLED=false
