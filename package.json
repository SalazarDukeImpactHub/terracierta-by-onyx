{
  "name": "terracierta-by-onyx",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "node scripts/dev-local.mjs",
    "db:reset": "supabase db reset",
    "test:db": "node scripts/test-db.mjs",
    "cloud:setup": "node scripts/cloud-sql.mjs setup",
    "cloud:update": "node scripts/cloud-sql.mjs update",
    "cloud:reset": "node scripts/cloud-sql.mjs reset",
    "test:rls": "supabase db reset && docker exec -i supabase_db_terracierta-by-onyx psql -U postgres -v ON_ERROR_STOP=1 -f - < supabase/tests/rls.sql",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@interledger/open-payments": "7.4.0",
    "@noble/curves": "2.4.0",
    "@noble/post-quantum": "0.7.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.109.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@interledger/open-payments": {
      "uuid": "11.1.1"
    },
    "@interledger/http-signature-utils": {
      "uuid": "11.1.1"
    }
  }
}
